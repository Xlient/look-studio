# Copy to .env and fill in values. Never commit .env.
# Server-only settings. Nothing here is bundled into the client.

# Meta Model API key (server reads it from the environment only)
MODEL_API_KEY=
# Model name for structured-output calls
MODEL_NAME=
# Server listen port
PORT=
# Max estimated model spend in USD per UTC day (HTTP 429 when exceeded)
DAILY_SPEND_CAP_USD=
# Max estimated model spend in USD per client IP per UTC day (HTTP 429 when exceeded)
CLIENT_DAILY_SPEND_CAP_USD=
# Estimated blended price per 1K tokens in USD
MODEL_PRICE_PER_1K_TOKENS_USD=
# Per-IP rate limit: max requests per window
RATE_LIMIT_MAX=
# Per-IP rate limit window in milliseconds
RATE_LIMIT_WINDOW_MS=
# Proxies in front of the server that append to X-Forwarded-For; 0 ignores the header
TRUSTED_PROXY_HOPS=
# Per-attempt model call timeout in milliseconds
MODEL_TIMEOUT_MS=
# Retries on HTTP 429 (exponential backoff with jitter)
MODEL_MAX_RETRIES=
